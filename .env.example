# Canonical public origin. Use HTTPS in production.
SITE_URL=http://localhost:3000

# Server-only contact integration. Leave blank until Phase 5/n8n configuration.
N8N_CONTACT_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_SECRET=
