# Canonical public production origin. Replace this safe placeholder.
SITE_URL=https://example.com

# The canonical production deployment must be indexable.
SEO_INDEXING_ENABLED=true

# Server-only contact integration. All three values are required to activate submissions.
# Production webhook URLs must use HTTPS. Never expose these values to the browser.
N8N_CONTACT_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_SECRET=
CONTACT_RATE_LIMIT_SALT=

# Optional server-side portal destination. Must use HTTPS when configured.
PORTAL_URL=

# Docker Compose host controls.
BIND_ADDRESS=127.0.0.1
PORT=3000
# deploy.sh derives IMAGE_TAG from Git HEAD. Set only for controlled overrides.
IMAGE_TAG=
